{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "1.0.0",
    "description": "CRUD API for tasks built with clean architecture."
  },
  "servers": [
    {
      "url": "http://localhost:8089"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Operations with tasks"
    },
    {
      "name": "Occurrences",
      "description": "Operations with task occurrences"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks",
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" },
              "examples": {
                "without_recurrence": {
                  "summary": "Task without recurrence",
                  "value": {
                    "title": "Prepare release",
                    "description": "Collect release notes and check migrations",
                    "status": "new"
                  }
                },
                "daily": {
                  "summary": "Daily recurrence",
                  "value": {
                    "title": "Drink water",
                    "description": "Reminder during the day",
                    "status": "new",
                    "recurrence": {
                      "type": "daily",
                      "start_date": "2026-04-21T00:00:00Z",
                      "every_n_days": 2,
                      "is_active": true
                    }
                  }
                },
                "monthly": {
                  "summary": "Monthly recurrence",
                  "value": {
                    "title": "Pay rent",
                    "description": "Monthly rent payment",
                    "status": "new",
                    "recurrence": {
                      "type": "monthly",
                      "start_date": "2026-04-21T00:00:00Z",
                      "day_of_month": 15,
                      "is_active": true
                    }
                  }
                },
                "specific_dates": {
                  "summary": "Specific dates recurrence",
                  "value": {
                    "title": "Doctor visits",
                    "description": "Scheduled appointments",
                    "status": "new",
                    "recurrence": {
                      "type": "specific_dates",
                      "start_date": "2026-04-21T00:00:00Z",
                      "is_active": true,
                      "dates": [
                        {
                          "run_date": "2026-04-22T00:00:00Z"
                        },
                        {
                          "run_date": "2026-04-29T00:00:00Z"
                        }
                      ]
                    }
                  }
                },
                "even_days": {
                  "summary": "Even days recurrence",
                  "value": {
                    "title": "Check metrics",
                    "description": "Run on even calendar days",
                    "status": "new",
                    "recurrence": {
                      "type": "even_days",
                      "start_date": "2026-04-21T00:00:00Z",
                      "is_active": true
                    }
                  }
                },
                "odd_days": {
                  "summary": "Odd days recurrence",
                  "value": {
                    "title": "Journal entry",
                    "description": "Run on odd calendar days",
                    "status": "new",
                    "recurrence": {
                      "type": "odd_days",
                      "start_date": "2026-04-21T00:00:00Z",
                      "is_active": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" },
              "examples": {
                "without_recurrence": {
                  "summary": "Task without recurrence",
                  "value": {
                    "title": "Prepare release",
                    "description": "Collect release notes and check migrations",
                    "status": "in_progress"
                  }
                },
                "daily": {
                  "summary": "Daily recurrence",
                  "value": {
                    "title": "Drink water",
                    "description": "Reminder during the day",
                    "status": "new",
                    "recurrence": {
                      "type": "daily",
                      "start_date": "2026-04-21T00:00:00Z",
                      "every_n_days": 2,
                      "is_active": true
                    }
                  }
                },
                "monthly": {
                  "summary": "Monthly recurrence",
                  "value": {
                    "title": "Pay rent",
                    "description": "Monthly rent payment",
                    "status": "new",
                    "recurrence": {
                      "type": "monthly",
                      "start_date": "2026-04-21T00:00:00Z",
                      "day_of_month": 15,
                      "is_active": true
                    }
                  }
                },
                "specific_dates": {
                  "summary": "Specific dates recurrence",
                  "value": {
                    "title": "Doctor visits",
                    "description": "Scheduled appointments",
                    "status": "new",
                    "recurrence": {
                      "type": "specific_dates",
                      "start_date": "2026-04-21T00:00:00Z",
                      "is_active": true,
                      "dates": [
                        {
                          "run_date": "2026-04-22T00:00:00Z"
                        },
                        {
                          "run_date": "2026-04-29T00:00:00Z"
                        }
                      ]
                    }
                  }
                },
                "even_days": {
                  "summary": "Even days recurrence",
                  "value": {
                    "title": "Check metrics",
                    "description": "Run on even calendar days",
                    "status": "new",
                    "recurrence": {
                      "type": "even_days",
                      "start_date": "2026-04-21T00:00:00Z",
                      "is_active": true
                    }
                  }
                },
                "odd_days": {
                  "summary": "Odd days recurrence",
                  "value": {
                    "title": "Journal entry",
                    "description": "Run on odd calendar days",
                    "status": "new",
                    "recurrence": {
                      "type": "odd_days",
                      "start_date": "2026-04-21T00:00:00Z",
                      "is_active": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/occurrences": {
      "get": {
        "tags": ["Occurrences"],
        "summary": "List task occurrences by date",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Date in YYYY-MM-DD format",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-04-22"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Occurrence list for the selected date",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TaskOccurrence" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/occurrences/{id}": {
      "patch": {
        "tags": ["Occurrences"],
        "summary": "Update occurrence status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskOccurrenceStatusRequest" },
              "examples": {
                "in_progress": {
                  "summary": "Set occurrence in progress",
                  "value": {
                    "status": "in_progress"
                  }
                },
                "done": {
                  "summary": "Set occurrence done",
                  "value": {
                    "status": "done"
                  }
                },
                "new": {
                  "summary": "Reset occurrence to new",
                  "value": {
                    "status": "new"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Occurrence updated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/tasks/{id}/occurrences": {
      "get": {
        "tags": ["Occurrences"],
        "summary": "List occurrences by task ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Occurrence list for the selected task",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TaskOccurrence" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"]
          },
          "recurrence": {
            "$ref": "#/components/schemas/TaskRecurrenceRequest"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"]
          },
          "recurrence": {
            "$ref": "#/components/schemas/TaskRecurrenceRequest"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Prepare release"
          },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "recurrence": {
            "$ref": "#/components/schemas/TaskRecurrenceResponse"
          }
        }
      },
      "TaskRecurrenceRequest": {
        "oneOf": [
          { "$ref": "#/components/schemas/DailyRecurrenceRequest" },
          { "$ref": "#/components/schemas/MonthlyRecurrenceRequest" },
          { "$ref": "#/components/schemas/SpecificDatesRecurrenceRequest" },
          { "$ref": "#/components/schemas/EvenDaysRecurrenceRequest" },
          { "$ref": "#/components/schemas/OddDaysRecurrenceRequest" }
        ]
      },
      "DailyRecurrenceRequest": {
        "type": "object",
        "required": ["type", "start_date", "is_active"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["daily"]
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "every_n_days": {
            "type": "integer",
            "minimum": 1
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "MonthlyRecurrenceRequest": {
        "type": "object",
        "required": ["type", "start_date", "day_of_month", "is_active"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["monthly"]
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "day_of_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "SpecificDatesRecurrenceRequest": {
        "type": "object",
        "required": ["type", "start_date", "is_active", "dates"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["specific_dates"]
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "is_active": {
            "type": "boolean"
          },
          "dates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/TaskRecurrenceDateRequest"
            }
          }
        }
      },
      "EvenDaysRecurrenceRequest": {
        "type": "object",
        "required": ["type", "start_date", "is_active"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["even_days"]
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "OddDaysRecurrenceRequest": {
        "type": "object",
        "required": ["type", "start_date", "is_active"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["odd_days"]
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "TaskRecurrenceDateRequest": {
        "type": "object",
        "required": ["run_date"],
        "properties": {
          "run_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TaskRecurrenceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 10
          },
          "task_id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "type": {
            "type": "string",
            "enum": ["daily", "monthly", "specific_dates", "even_days", "odd_days"],
            "example": "specific_dates"
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-21T00:00:00Z"
          },
          "every_n_days": {
            "type": "integer",
            "nullable": true,
            "example": 2
          },
          "day_of_month": {
            "type": "integer",
            "nullable": true,
            "example": 15
          },
          "is_active": {
            "type": "boolean",
            "example": true
          },
          "dates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskRecurrenceDateResponse"
            }
          }
        }
      },
      "TaskRecurrenceDateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 100
          },
          "recurrence_id": {
            "type": "integer",
            "format": "int64",
            "example": 10
          },
          "run_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-22T00:00:00Z"
          }
        }
      },
      "TaskOccurrence": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "task_id": {
            "type": "integer",
            "format": "int64",
            "example": 10
          },
          "recurrence_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "example": 5
          },
          "scheduled_date": {
            "type": "string",
            "format": "date",
            "example": "2026-04-22"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2026-04-22T14:30:00Z"
          }
        }
      },
      "UpdateTaskOccurrenceStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "done"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "task not found"
          }
        }
      }
    }
  }
}